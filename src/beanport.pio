;
; beanport.pio
; captures D0-D7 on parallel port write cycles and
; drives D0-D7 on parallel port read cycles.
;
; GP0-7  = D0-D7
; GP8    = R/W   HIGH = write, assigned as JMP pin to branch to capture when writing
; GP9    = EN#   wait for this to go low before doing anything
; GP10   = A0    port/register select : 0 = STATUS (port 12), 1 = DATA (port 13)
; GP11   = TX ready - driven by the core (SIO), sensed here as a plain input, same as A0
; GP12   = RX available - driven by the core (SIO), sensed here as a plain input, same as A0
;
; Write path: once a write is confirmed, wait a deliberate margin
; before sampling, push the byte, then wait for EN# to deassert before
; re-arming.
;
; Read path: critical timing - a tight budget measured from EN#
; asserting to data being output. Falls through from `jmp pin capture`
; into read_path; `mov osr, pins` grabs a live GPIO snapshot in one
; instruction to extract A0 and the STATUS byte.
; DATA (A0=1) outputs the latest byte received from the FIFO, or the
; previous one if the FIFO is empty. 
; STATUS (A0=0) output GP11/GP12's current state directly as bit0/bit1
; the core is the source of truth for both bits, this just relays whatever it last set.
; Flip D0-7 back to inputs once EN# deasserts.

.program beanport

; initialise - this will be sent on a read before actual data is in the FIFO
set x, 0

.wrap_target
retry:
    wait 0 gpio 9       ; Wait for EN# to go to 0 (asserted)
    jmp pin capture     ; R/W high -> write; falls through to read_path otherwise
read_path:
    mov osr, !null      ; set all 1s
    out pindirs, 8      ; D0-D7 -> outputs (set pindirs only sets 5 bits)

    mov osr, pins        ; live snapshot of GP0-31, rotated so GP0 = bit 0
    out null, 10          ; discard bits 0-9 (D0-D7, R/W, EN#); osr bit 0 = A0
    mov y, osr
    jmp !y status_path      ; A0=0 -> port 12 (STATUS)
data_path:
    pull noblock        ; latest byte from FIFO (or x, auto-substituted if empty)
    mov x, osr          ; re-cache it
    out pins, 8         ; output the byte onto D0-D7
    jmp output_done
status_path:
    mov osr, pins        ; re-sample - cheap enough not to bother saving/reusing
    out null, 11           ; discard bits 0-10; osr bit0 = GP11 (TX ready), bit1 = GP12 (RX available)
    out pins, 8              ; output the status byte (bits 2-7 come out zero)
output_done:
    wait 1 gpio 9       ; wait for EN# to go high (deassert)
    mov osr, null
    out pindirs, 8      ; D0-D7 -> inputs again
    jmp retry
capture:
    ; Deliberate margin before sampling - 7 PIO cycles (~52.5ns @ 133MHz), which is half a
    ; Z80 T-state (100ns @ 10MHz). Analysis is required to determine what the delay should be
    nop [6]
    in pins, 8          ; sample D0-D7
    push                ; hand the byte to the RX FIFO
    wait 1 gpio 9       ; wait for EN# to deassert before re-arming
    jmp retry
.wrap

% c-sdk {

static inline void beanport_program_init(PIO pio, uint sm, uint offset, uint base_pin) {

    pio_sm_config c = beanport_program_get_default_config(offset);
    sm_config_set_in_pins(&c, base_pin);
    sm_config_set_out_pins(&c, base_pin, 8); 
    sm_config_set_jmp_pin(&c, 8); // GP8 = R/W

    // D0-D7 as inputs; only the data pins will be function selected for the PIO
    // Address and control lines are only ever sensed by the PIO, never output to
    // so they are not included here

    // default the data pins to PIO inputs
    pio_sm_set_consecutive_pindirs(
        pio, sm, base_pin,
        8,      // data pins
        false   // is_out=false
    );

    // PIO function select the data GPIOs
    for (int i = 0; i < 8; i++) pio_gpio_init(pio, i);

    // Shift left rather than the SDK default (right) - shift-left inserts new
    // bits at bit 0, so the sampled byte lands in the lowest 8 bits of the
    // 32-bit word for ease of use in C
    sm_config_set_in_shift(
        &c,
        false,  // shift-to-right = false
        false,  // autopush disabled
        32      // autopush threshold (not significant as autopush is disabled)
    );

    // no need to call sm_config_set_out_shift() - accept the default shift-to-right

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

%}