; beanport.pio
;
; captures D0-D7 on bus write cycles and
; drives D0-D7 on bus read cycles
;
; GP0-7  = D0-D7
; GP8    = R/W - HIGH = write (jmp pin)
; GP9    = EN#
; GP10   = A0 - 0 = STATUS/CONFIG, 1 = DATA
; GP11   = READ_AVAILABLE_PIN - a byte is waiting in the TX-FIFO for the bus to receive

.program beanport

; initialise
set x, 0                  ; data cache

.wrap_target
start:
    wait 0 gpio 9         ; Wait for EN# to be asserted (low)
    jmp pin bus_write     ; R/W (jmp pin) high = write, low = read
bus_read:
    mov osr, !null        ; all 1s
    out pindirs, 8        ; Set D0-D7 as outputs (set pindirs only sets 5 bits)
    mov osr, pins         ; snapshot of GP0-31
    out null, 10          ; discard bits 0-9 (D0-D7, R/W, EN#) - bit 0 is now A0
    out y, 1              ; isolate bit 0 (A0) into y - y is replaced by value of single bit
    jmp !y read_status    ; A0=0 -> STATUS
read_data:
    pull noblock          ; byte from FIFO - x (cache) is substituted if FIFO is empty
    mov x, osr            ; re-cache it
    out pins, 8           ; output the byte onto D0-D7
    jmp read_done
read_status:
    mov isr, null         ; clear ISR
                          ; status all 1s if the RX-FIFO has room (write-ready)
    mov y, status         ; y = status = write-ready
    in y, 1               ; shift 1 bit from y into the ISR = write-ready
    mov osr, pins         ; load osr with pin snapshot
    out null, 11          ; shift right - discard bits 0-10 (D0-D7, R/W, EN#, A0)
                          ; read-available pin is set by the core loop
    out y, 1              ; y = osr bit 0 = read-available (GP11)
    in y, 1               ; shift 1 bit from y into the ISR = read-available (ISR bit 0)
                          ; ISR bit 1 now = write-ready - matches the 6850 ACIA
                          ; convention (RDRF/bit0, TDRE/bit1), not the 8251's
    mov osr, isr          ; move the assembled status byte into osr
    out pins, 8           ; output the status byte
read_done:
    wait 1 gpio 9         ; wait for EN# to deassert
    mov osr, null         ; all 0s
    out pindirs, 8        ; Set D0-D7 as inputs (set pindirs only sets 5 bits)
    jmp start
bus_write:
    ; Deliberate margin before sampling - 7 PIO cycles (~52.5ns @ 133MHz), estimated to be
    ; half a 10MHz Z80 T-state. 
    ; TODO: further analysis is required
    nop [6]
    in pins, 8            ; sample D0-D7
    push                  ; > RX FIFO
    wait 1 gpio 9         ; wait for EN# to deassert
    jmp start
.wrap

% c-sdk {

static inline void beanport_program_init(PIO pio, uint sm, uint offset, uint base_pin) {

    pio_sm_config c = beanport_program_get_default_config(offset);
    sm_config_set_in_pins(&c, base_pin);
    sm_config_set_out_pins(&c, base_pin, 8); 
    sm_config_set_jmp_pin(&c, 8); // GP8 = R/W

    // mov status is set automatically on RX-FIFO (write-ready)
    // this value is therefore never stale
    sm_config_set_mov_status(&c, STATUS_RX_LESSTHAN, 4);

    // D0-D7 as inputs; only the data pins will be function selected for the PIO
    // PIO only reads address and control lines, so we do not initialise them here
    // as by default PIOs can read state of any pin

    // default the data pins to PIO inputs
    pio_sm_set_consecutive_pindirs(
        pio, sm, base_pin,
        8,      // data pins
        false   // is_out=false
    );

    // PIO function select the data GPIOs
    for (int i = 0; i < 8; i++) pio_gpio_init(pio, i);

    // Shift left rather than the SDK default (right) - shift-left inserts new
    // bits at bit 0, so the sampled byte lands in the lowest 8 bits of the
    // 32-bit word for ease of use in C
    sm_config_set_in_shift(
        &c,
        false,  // shift-to-right = false
        false,  // autopush disabled
        32      // autopush threshold (not significant as autopush is disabled)
    );

    // no need to call sm_config_set_out_shift() - accept the default shift-to-right

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

%}