;
; bus_capture.pio - captures D0-D7 on genuine Z80 I/O write cycles.
;
; GP0-7 = D0-D7 (IN pins, base 0)
; GP8   = IORQ# (JMP pin, active-low)
; GP10  = WR#   (absolute GPIO wait, active-low)
;
; Triggers on WR# (shared by both memory and I/O writes), then checks
; IORQ#'s *current* level as an immediate branch rather than a separate
; blocking wait - the two must be checked essentially atomically, because
; IORQ# can go low for something unrelated (e.g. an earlier I/O read) and
; then go stale while a later, unrelated WR# pulse (any ordinary memory
; write) satisfies a blocking wait on WR# with no way to notice IORQ# is
; no longer actually asserted. `jmp pin` reads GP8 fresh on the very next
; PIO cycle after WR# is seen low, so there's no window for that race.
;
; Once a genuine write is confirmed, samples the data bus, pushes the
; byte, then waits for WR# to deassert before re-arming - since D0-D7
; can't change again until the next write cycle starts, there's nothing
; to gain by re-triggering before this one has ended.

.program bus_capture

.wrap_target
retry:
    wait 0 gpio 10      ; WR# asserted - a memory or I/O write
    jmp pin retry       ; IORQ# (JMP pin) still high -> not I/O, go re-wait WR#
    in pins, 8          ; genuine I/O write - sample D0-D7
    push                ; hand the byte to the RX FIFO
    wait 1 gpio 10      ; wait for WR# to deassert before re-arming
.wrap
