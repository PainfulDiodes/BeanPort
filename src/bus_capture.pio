;
; bus_capture.pio - Z80 I/O read/write cycles for BeanPort's decoded port.
;
; GP0-7  = D0-D7 (IN pins AND OUT pins, base 0 - bidirectional data bus)
; GP8    = R/W   (JMP pin; un-inverted Z80 RD#, active-low = reading)
; GP9    = EN#   (absolute GPIO wait, active-low; '138 decode output -
;                 already encodes IORQ# asserted AND this port addressed)
; GP10   = A0    (raw Z80 A0, not decoded by the '138 - distinguishes the
;                 two ports EN# covers; sampled alongside D0-D7 on write,
;                 see write_path below)
;
; Triggers on EN# (the '138 decode output, encoding "IORQ# asserted and
; this port is addressed") for both directions, then checks R/W's
; *current* level as an immediate branch rather than a separate blocking
; wait - checking the two together atomically avoids a stale read: R/W
; could go low for an earlier, unrelated read and go stale by the time a
; later EN# assertion is seen, so `jmp pin` reads GP8 fresh on the very
; next PIO cycle after EN# is seen low.
;
; WRITE (R/W high - not reading, so a genuine write): waits a deliberate
; margin before sampling (see `write_path:` below), pushes the byte to
; the RX FIFO, then waits for EN# to deassert before re-arming.
;
; READ (R/W low): C keeps two independent bytes (port A / port B) and
; always pushes them combined as one 16-bit word (low byte = port A,
; high byte = port B) whenever either changes - `pull noblock` takes the
; newest combined word, falling back to the previous one (cached in X)
; if C hasn't pushed a fresh one since the last read, so this never
; blocks waiting on C. Which half to actually drive is decided here, by
; sampling A0 live: `jmp pin` isn't available for it (that slot's
; already spoken for by R/W above, and a state machine only gets one),
; so A0 is captured via `in pins` alongside D0-D7/R/W/EN# and peeled out
; bit-by-bit with `out null, N` / `out Y, 1` instead - slower than a
; `jmp pin` branch, but the only way to test an arbitrary sampled bit
; when the one jmp_pin slot is already committed elsewhere. Only the
; direction switch and drive - the part with a real timing budget -
; happens here: GP0-7 flip to outputs, drive the byte, then flip back to
; inputs the instant EN# deasserts. Hardware DIR (wired directly to RD#,
; not through the Pico) makes the same switch independently and faster;
; this just has to keep pace with it closely enough not to contend with
; the level shifter's own driver on the next write.

.program bus_capture

; Runs once at start, before .wrap_target - pio_sm_restart() (called by
; pio_sm_init()) explicitly leaves X and Y untouched, so without this X
; would hold whatever the silicon happens to reset to, not a value this
; program actually chose. Only X needs it: it's the one read_path relies
; on as a fallback (via `pull noblock`) before C has ever pushed a value.
set x, 0

.wrap_target
retry:
    wait 0 gpio 9       ; EN# asserted - addressed I/O cycle (read or write)
    jmp pin write_path  ; R/W (JMP pin) high -> not reading -> genuine write
read_path:              ; R/W low -> genuine read (fallthrough)
    pull noblock        ; OSR = newest combined word from C, or if none waiting = x
    mov x, osr          ; cache it - X always holds "the current combined word"
    in pins, 11         ; fresh GP0-10 sample; bit 10 = A0 (D0-D7/R/W/EN#
                        ; ride along unused, same shape as write_path's capture)
    mov osr, isr        ; move the sample into OSR so it can be peeled with `out`
    out null, 10        ; discard the low 10 bits (not A0)
    out y, 1            ; Y = A0 (0 or 1), isolated
    mov osr, x          ; OSR = combined word again, ready to extract a byte
    jmp !y byte_ready   ; A0=0 -> port A's byte is already in OSR's low 8 bits
    out null, 8         ; A0=1 -> discard port A's byte, promoting port B's
byte_ready:
    out y, 8            ; stash the data in Y
    mov osr, ~ null     ; OSR = all 1s
    out pindirs, 8      ; GP0-7 -> outputs
    mov osr, y          ; restore OSR
    out pins, 8         ; send data
    wait 1 gpio 9       ; wait for EN# to deassert
    mov osr, null       ; OSR = 0
    out pindirs, 8      ; GP0-7 -> back to inputs
    jmp retry
write_path:
    ; Deliberate margin before sampling - 7 PIO cycles (~52.5ns @ 133MHz),
    ; chosen as half a Z80 T-state (100ns @ 10MHz) rather than the fuller
    ; analysis in log_prop_del.md (which timed the older WR#-triggered
    ; design and no longer applies as-is - see that file's open item (1)).
    ; Comfortably clears the worst-case data-valid point: OE# on the data
    ; level-shifter is driven directly from the same '138 output as EN#
    ; (not routed through the Pico), so data is already valid by ~44ns
    ; worst-case (40ns '138 decode + 4ns chip 1 propagation) after the
    ; Z80 asserts - well before this delay (starting only once EN# has
    ; already reached and been recognized by the PIO, ~19ns in on its
    ; own) elapses.
    nop [6]
    in pins, 11         ; sample D0-D7 (bits 0-7), R/W (bit 8, always 1
                        ; here), EN# (bit 9, always 0 here), and A0 (bit
                        ; 10) - one shot from IN_BASE=0; R/W and EN# ride
                        ; along unused, C masks out just what it needs
    push                ; hand the word to the RX FIFO
    wait 1 gpio 9       ; wait for EN# to deassert before re-arming
.wrap
